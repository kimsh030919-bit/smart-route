# ───────────────────────────────────────────────────────────────
# SMART ROUTE 환경변수
#
# 1) 이 파일을 .env 로 복사합니다.      cp .env.example .env
# 2) 카카오 디벨로퍼스에서 발급한 "JavaScript 키"를 넣습니다.
#    https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 3) 같은 앱의 [플랫폼 → Web] 사이트 도메인에 http://localhost:5173 을 등록해야
#    SDK가 정상 동작합니다.
#
# 키가 없어도 앱은 "데모 모드"로 전체 기능(검색/최적화/타임라인/지도 개념도)이
# 동작합니다. 키를 넣으면 실제 장소 검색과 카카오맵 표시로 자동 전환됩니다.
# ───────────────────────────────────────────────────────────────
VITE_KAKAO_MAP_KEY=

# ───────────────────────────────────────────────────────────────
# 브이월드(국토교통부 공간정보 오픈플랫폼) 인증키
#
# 1) https://www.vworld.kr 회원가입 → [오픈API] → [인증키 발급]
# 2) 발급 신청 시 반드시 체크:
#      - WMTS/TMS API   (배경지도 타일)
#      - 검색 API       (지명/주소 검색)
#      - 지오코더 API   (주소 → 좌표)
# 3) "활용 URL(사이트 도메인)"에 개발 주소를 등록: http://localhost:5173
#    (등록한 주소와 다른 곳에서 호출하면 인증 실패 403/오류 응답)
# 4) 이메일 승인 후 키가 활성화됩니다.
#
# 브이월드는 "지도 타일 + 지명/주소 검색 + 공간 데이터"만 제공합니다.
# 영업시간 · 휴무 · 브레이크타임 · 길찾기(이동시간)는 제공하지 않으므로
# 브이월드로 담은 장소는 "정보 확인 필요"로 표시되고 직접 입력해야 합니다.
# ───────────────────────────────────────────────────────────────
VITE_VWORLD_API_KEY=

# 브이월드 JSON API 프록시가 보낼 Referer (인증키에 등록한 활용 URL과 동일하게)
# VITE_ 접두사가 없으므로 브라우저에 노출되지 않고 vite 서버에서만 사용됩니다.
VWORLD_REFERER=http://localhost:5173

# 브이월드 검색/지오코더 호출 방식
#   auto  (기본) : 개발 = 프록시, 배포 = JSONP
#   proxy        : 항상 서버(프록시) 경유. 서버를 둘 수 있는 환경에서 권장
#   jsonp        : 항상 브라우저에서 api.vworld.kr 직접 호출 (정적 호스팅에서 검색 가능)
# VITE_VWORLD_TRANSPORT=auto

# 프록시 경로를 직접 지정할 때 (다른 서버/워커에 올린 경우, 절대 URL 가능)
# VITE_VWORLD_PROXY_BASE=/vworld-api

# ───────────────────────────────────────────────────────────────
# 경로(길찾기) 엔진 — 브이월드는 길찾기 API를 제공하지 않습니다.
#
# 기본값: OSRM 공개 데모 서버 (키 불필요, CORS 허용)
#   · 자동차 프로파일만 제공 → 자동차는 실측, 도보/자전거는 도로거리 + 속도환산 추정
#   · 데모 서버는 테스트 용도이므로 실서비스에서는 자체 OSRM 설치 또는 상용 API 권장
# VITE_OSRM_BASE=https://router.project-osrm.org
#
# OpenRouteService 키를 넣으면 도보/자전거도 전용 프로파일로 실제 경로를 계산합니다.
#   발급: https://openrouteservice.org/dev/#/signup (무료 플랜)
# VITE_ORS_API_KEY=
# ───────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────
# 실제 영업시간: 기본값은 OpenStreetMap (설정할 것이 없습니다)
#
# 장소를 담으면 OpenStreetMap(Overpass API)에서 그 장소의 실제 영업시간을
# 자동으로 찾아 채웁니다. **API 키·회원가입·결제가 전혀 필요 없고 전국에서 동작합니다.**
#   · 가져오는 것: 요일별 영업시간, 브레이크 타임(같은 날 영업 구간이 나뉜 경우), 정기 휴무요일
#   · 가져오지 못하는 것: 라스트 오더, 특정 날짜 임시 휴무 (직접 입력 필요)
#   · 한계: OSM에 영업시간이 등록된 장소만 채워집니다. 등록이 없으면 손대지 않고
#           업종 추정값/"정보 확인 필요" 상태로 남습니다. (없는 정보를 지어내지 않습니다)
#   · 커뮤니티가 입력한 데이터라 최신이 아닐 수 있습니다. check_date 태그가 있으면 함께 표시합니다.
#   · 공개 서버(overpass-api.de 등)를 사용하므로 간헐적으로 혼잡(429)할 수 있습니다.
#     그럴 때는 "실제 영업시간 불러오기" 버튼으로 다시 시도하면 됩니다.
# ───────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────────────────────
# (선택) 구글 Places API (New) — OSM보다 커버리지가 넓은 유료 대안
#
# OSM에 등록되지 않은 장소까지 영업시간을 채우고 싶을 때만 설정하세요.
# 설정하지 않아도 위의 OpenStreetMap 연동은 그대로 동작합니다.
#
# 설정 방법
#  1) https://console.cloud.google.com 프로젝트 생성
#  2) "Places API (New)" 사용 설정 (결제 계정 연결 필요 — 월 무료 크레딧 제공)
#  3) 사용자 인증 정보 → API 키 생성
#  4) 키 제한 → 애플리케이션 제한: HTTP 리퍼러에
#       http://localhost:5173/*  와  https://<배포도메인>/*  등록
#     API 제한: Places API (New) 만 허용
#
# 가져오는 것: 요일별 영업시간, 브레이크 타임(같은 날 영업 구간이 나뉜 경우), 임시/영구 폐업 상태
# 가져오지 못하는 것: 라스트 오더, 특정 날짜 임시 휴무 (직접 입력 필요)
# ───────────────────────────────────────────────────────────────
VITE_GOOGLE_PLACES_KEY=
